# OpenAI-compatible LLM endpoint, for example DeepSeek/OpenAI-compatible gateways.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8192
# Optional override for gateways protected by browser/bot filters.
LLM_USER_AGENT=

# Conversation Harness budget (set to your provider/model's actual window).
# Includes system/task context, history, tool schemas, results and output reserve.
# Conservative UTF-8 byte estimator, not the provider's billed token count.
OPENMUSE_CONTEXT_TOKENS=32768
OPENMUSE_OUTPUT_TOKENS=4096

# WeChat Official Account credentials for real draft creation.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Feishu/Lark webhook for notifications.
FEISHU_WEBHOOK_URL=

# Optional: GitHub token for higher API rate limits (5000/hour vs 60/hour).
GITHUB_TOKEN=
