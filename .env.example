# OpenAI-compatible LLM endpoint, for example DeepSeek/OpenAI-compatible gateways.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
LLM_MAX_TOKENS=8192

# WeChat Official Account credentials for real draft creation.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Feishu/Lark webhook for notifications.
FEISHU_WEBHOOK_URL=

# Optional: GitHub token for higher API rate limits (5000/hour vs 60/hour).
GITHUB_TOKEN=

